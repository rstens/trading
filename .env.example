# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Provider-specific reasoning / thinking effort (each only applies when
# its matching provider is selected). Valid values are passed through to
# the SDK as-is — see each provider's docs for the accepted set.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium   # minimal | low | medium | high
#TRADINGAGENTS_ANTHROPIC_EFFORT=medium          # low | medium | high
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=medium     # minimal | low | medium | high

# Persistence — Postgres + pgvector. Leave unset to keep the app in the
# legacy in-memory + markdown-fallback mode. The docker-compose
# `persistence` profile sets this automatically.
#TRADINGAGENTS_DATABASE_URL=postgresql+psycopg://tradingagents:tradingagents@localhost:5432/tradingagents

# Embedding provider for the vector store (Phase 4). Unset = auto-pick
# based on TRADINGAGENTS_LLM_PROVIDER (openai/google → use them;
# anything else → fall back to openai).
#TRADINGAGENTS_EMBEDDING_PROVIDER=openai       # openai | google
#TRADINGAGENTS_EMBEDDING_MODEL=text-embedding-3-small
#TRADINGAGENTS_EMBEDDING_DIM=1536              # MUST match the chosen model's output dim

# Postgres password for the docker-compose `postgres` service.
#POSTGRES_PASSWORD=tradingagents

# Host-side port mapping for docker-compose services. Defaults avoid
# clashing with a host-side Postgres on 5432 and let multiple compose
# stacks coexist.
#POSTGRES_PORT=5433
#TRADINGAGENTS_PORT=8000
#OLLAMA_PORT=11434
